{
  "name": "evision-evms-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "owner:create": "node --env-file-if-exists=.env scripts/create-owner.js",
    "report:run": "node --env-file-if-exists=.env scripts/report.js",
    "test:browser": "node scripts/browser-check.js",
    "audit:content": "node scripts/audit.js",
    "test:redesign": "node scripts/acceptance.js",
    "lint": "eslint server scripts public tests eslint.config.js && node scripts/lint.js",
    "test:all": "npm run lint && npm test && npm run build && npm run test:browser && npm run test:redesign && npm run audit:content"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.11",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.10",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
